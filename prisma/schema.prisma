generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AttendanceLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @db.Date
  deviceId   String
  employeeId String
  user       User     @relation("UserAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  punchType  String
  timestamp  DateTime @db.Date
  updatedAt  DateTime @db.Date
}

model Leave {
  id         String   @id @default(uuid())
  createdAt  DateTime @db.Date
  employeeId String
  user       User     @relation("UserLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  endDate    DateTime @db.Date
  reason     String
  startDate  DateTime @db.Date
  status     String
  totalDays  BigInt
  type       String
  updatedAt  DateTime @db.Date
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @db.Date
  message   String
  read      Boolean
  type      String
  updatedAt DateTime @db.Date
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model Payroll {
  id          String   @id @default(uuid())
  absentDays  BigInt
  baseSalary  BigInt
  createdAt   DateTime @db.Date
  employeeId  String
  user        User     @relation("UserPayrolls", fields: [employeeId], references: [id], onDelete: Cascade)
  grossSalary BigInt
  month       BigInt
  presentDays BigInt
  status      String
  totalDays   BigInt
  updatedAt   DateTime @db.Date
  year        BigInt
}

model User {
  id           String   @id @default(uuid())
  baseSalary   BigInt
  createdAt    DateTime @db.Date
  department   String?
  designation  String?
  email        String   @unique
  employeeId   String   @unique
  isActive     Boolean
  joiningDate  DateTime @db.Date
  name         String
  password     String
  profileImage String
  role         String
  updatedAt    DateTime @db.Date

  attendanceLogs AttendanceLog[] @relation("UserAttendance")
  leaves         Leave[]         @relation("UserLeaves")
  notifications  Notification[]  @relation("UserNotifications")
  payrolls       Payroll[]       @relation("UserPayrolls")
}
