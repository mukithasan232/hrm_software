generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "mysql"
}

model AttendanceLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  deviceId   String
  employeeId String
  user       User     @relation("UserAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  punchType  String
  timestamp  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, timestamp])
}

model Leave {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  employeeId String
  user       User     @relation("UserLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  endDate    DateTime
  reason     String
  startDate  DateTime
  status     String
  totalDays  Int
  type       String
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  message   String
  read      Boolean  @default(false)
  type      String
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model Payroll {
  id          String   @id @default(uuid())
  absentDays  Int
  baseSalary  Float
  createdAt   DateTime @default(now())
  employeeId  String
  user        User     @relation("UserPayrolls", fields: [employeeId], references: [id], onDelete: Cascade)
  grossSalary Float
  month       Int
  presentDays Int
  status      String
  totalDays   Int
  updatedAt   DateTime @updatedAt
  year        Int
}

model Performance {
  id                     String   @id @default(uuid())
  employeeId             String
  employee               User     @relation("UserPerformances", fields: [employeeId], references: [id], onDelete: Cascade)
  month                  Int
  year                   Int
  taskScore              Float
  managerRating          Float
  feedback               String
  punctualityScore       Float
  calculatedOverallScore Float
  isEOTM                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model User {
  id           String   @id @default(uuid())
  baseSalary   Float    @default(0)
  createdAt    DateTime @default(now())
  department   String?
  designation  String?
  email        String   @unique
  employeeId   String   @unique
  isActive     Boolean  @default(true)
  joiningDate  DateTime @default(now())
  name         String
  password     String
  profileImage String?
  role         String   @default("Employee")
  updatedAt    DateTime @updatedAt

  attendanceLogs AttendanceLog[] @relation("UserAttendance")
  leaves         Leave[]         @relation("UserLeaves")
  notifications  Notification[]  @relation("UserNotifications")
  payrolls       Payroll[]       @relation("UserPayrolls")
  performances   Performance[]   @relation("UserPerformances")
}
