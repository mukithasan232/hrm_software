generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "mysql"
}

enum EmployeeType {
  REMOTE
  IN_HOUSE
  HYBRID
}

enum EmployeeStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING
  COMPLETED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Dynamic Designation model for the RBAC Team module
// permissions is stored as JSON: { "attendance.view": true, "leaves.approve": true, ... }
model Designation {
  id          String   @id @default(uuid())
  name        String   @unique
  description       String?
  leaveConfig       Json?    @default("{}")
  totalCasualLeaves Int      @default(0)
  totalSickLeaves   Int      @default(0)
  permissions       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Department {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  shiftStartTime    String   @default("09:00")
  shiftEndTime      String   @default("17:00")
  lunchStartTime    String?
  lunchEndTime      String?
  snacksStartTime   String?
  snacksEndTime     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users             User[]
}


model Shift {
  id        String   @id @default(cuid())
  name      String   @unique
  startTime String   
  endTime   String   
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  deviceId   String
  employeeId String
  user       User     @relation("UserAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  punchType  String
  timestamp  DateTime @default(now())
  checkOut   DateTime?
  updatedAt  DateTime @updatedAt

  otStatus          String @default("PENDING")
  approvedOtMinutes Int    @default(0)

  @@unique([employeeId, timestamp])
  @@index([timestamp(sort: Desc)])
  @@index([timestamp, punchType])
}

model Leave {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  employeeId String
  user       User     @relation("UserLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  endDate    DateTime
  reason     String
  startDate  DateTime
  status     String   @default("Pending")
  totalDays  Int
  type       String
  attachment String?
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  titleEn   String?
  titleBn   String?
  messageEn String
  messageBn String?
  read      Boolean  @default(false)
  type      String
  referenceId String?
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model Payroll {
  id          String   @id @default(uuid())
  absentDays  Int
  baseSalary  Float
  createdAt   DateTime @default(now())
  employeeId  String
  user        User     @relation("UserPayrolls", fields: [employeeId], references: [id], onDelete: Cascade)
  grossSalary Float
  month       Int
  presentDays Int
  status      String
  totalDays   Int
  updatedAt   DateTime @updatedAt
  year        Int

  @@unique([employeeId, month, year])
}

model Performance {
  id                     String   @id @default(uuid())
  employeeId             String
  employee               User     @relation("UserPerformances", fields: [employeeId], references: [id], onDelete: Cascade)
  month                  Int
  year                   Int
  taskScore              Float
  managerRating          Float
  feedback               String
  punctualityScore       Float
  calculatedOverallScore Float
  isEOTM                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  employeeId   String   @unique
  name         String
  password     String
  isActive     Boolean  @default(true)
  baseSalary            Float    @default(0)
  leaveConfig           Json?    @default("{}")
  casualLeaveAdjustment Int      @default(0)
  sickLeaveAdjustment   Int      @default(0)
  permissions           Json?    @default("{}")
  department            String?
  designation  String?
  shiftStartTime String?
  shiftEndTime   String?
  shift2Start    String?
  shift2End      String?
  joiningDate  DateTime @default(now())
  profileImage String?
  salaryAccount String?
  appointmentLetter String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Dynamic RBAC — relational link to a Designation entity
  designationId     String?
  customDesignation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  // Granular RBAC Role (Many-to-Many)
  roles Role[] @relation("UserRoles")

  // Department Relation
  departmentId     String?
  customDepartment Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Shift Relation
  shiftId          String?
  shift            Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // ZKTeco hardware mapping
  zktecoId Int? @unique

  employeeType     EmployeeType @default(IN_HOUSE)
  verificationStatus EmployeeStatus @default(UNVERIFIED)
  userType         String       @default("Employee")
  documents        Json         @default("[]")
  resetToken       String?
  resetTokenExpiry DateTime?

  // Contact & Social Media
  phone        String?
  facebook     String?
  linkedin     String?
  github       String?
  twitter      String?
  facebookUrl  String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  signatureUrl String?

  attendanceLogs AttendanceLog[] @relation("UserAttendance")
  leaves         Leave[]         @relation("UserLeaves")
  notifications  Notification[]  @relation("UserNotifications")
  payrolls       Payroll[]       @relation("UserPayrolls")
  performances   Performance[]   @relation("UserPerformances")
  zkSyncLogs     ZkSyncLog[]     @relation("UserZkSyncLogs")
  zkSyncQueues   ZkSyncQueue[]   @relation("UserZkSyncQueue")
  announcements  Announcement[]  @relation("AnnouncementAuthor")
  userPermission UserPermission?
  assignedTasks  Task[]          @relation("AssignedTasks")
  createdTasks   Task[]          @relation("CreatedTasks")
}

// Single-row tenant branding config (white-label SaaS)
model TenantSettings {
  id             String   @id @default(uuid())
  companyName    String   @default("HRM Portal")
  companyAddress String?  @db.Text
  logoUrl        String?  @db.LongText
  faviconUrl     String?  @db.LongText
  primaryColor   String   @default("#8b5cf6")
  secondaryColor String   @default("#06b6d4")
  updatedAt      DateTime @updatedAt

  smtpSettings SmtpSettings?
}

model Device {
  id        String   @id @default(cuid())
  name      String // e.g., "Main Gate"
  ipAddress String
  port      Int      @default(4370)
  commKey   Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RawDeviceLog {
  id           String   @id @default(uuid())
  deviceUserId String
  recordTime   DateTime
  punchType    String?
  ip           String?
  createdAt    DateTime @default(now())

  @@unique([deviceUserId, recordTime])
  @@index([recordTime(sort: Desc)])
}

model ZkSyncQueue {
  id         String   @id @default(uuid())
  employeeId String
  user       User     @relation("UserZkSyncQueue", fields: [employeeId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // pending, completed, failed
  lastError  String?  @db.Text
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model ZkSyncLog {
  id           String   @id @default(uuid())
  employeeId   String
  user         User     @relation("UserZkSyncLogs", fields: [employeeId], references: [id], onDelete: Cascade)
  enrollNumber Int
  action       String // created, updated, deleted
  status       String // success, failure
  errorMessage String?  @db.Text
  syncedAt     DateTime @default(now())
}

model Announcement {
  id               String   @id @default(cuid())
  title            String
  message          String   @db.Text
  targetType       String // "GLOBAL", "DEPARTMENT", "INDIVIDUAL"
  targetDepartment String? // e.g., "Software & Web Dev" (if targetType is DEPARTMENT)
  targetUserId     String? // (if targetType is INDIVIDUAL)
  createdAt        DateTime @default(now())
  authorId         String
  author           User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
}

model SmtpSettings {
  id           String   @id @default(uuid())
  host         String
  port         Int
  security     String // e.g., "SSL/TLS", "STARTTLS", "None"
  username     String
  password     String
  // MAIN tab fields
  senderName   String? // e.g., "HRM Portal"
  senderEmail  String? // e.g., "no-reply@company.com"
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String?         @unique
  tenant   TenantSettings? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id         String   @id @default(uuid())
  type       String   @unique // e.g., 'WELCOME_EMAIL', 'LEAVE_UPDATE', 'HR_NOTIFICATION'
  subject    String
  body       String   @db.Text
  designJson Json?
  updatedAt  DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] @relation("UserRoles")
}

model UserPermission {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matrix    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?      @db.Text
  attachment   String?
  outputFiles  Json?        @default("[]")
  comments     Json?        @default("[]")
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(NORMAL)
  assignedToId String
  assignedTo   User         @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId])
  @@index([status])
}
