{
  "name": "hrm-software-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "start": "concurrently -c \"green.bold,blue.bold\" -n \"PROD-BACKEND,PROD-FRONTEND\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -c \"cyan.bold,magenta.bold\" -n \"DEV-BACKEND,DEV-FRONTEND\" \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "next": "latest"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakkhor909/fap-hrm.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Sakkhor909/fap-hrm/issues"
  },
  "homepage": "https://github.com/Sakkhor909/fap-hrm#readme"
}
