{
  "name": "fap-hrm-monolith",
  "private": true,
  "scripts": {
    "dev": "npx prisma generate && node server.cjs",
    "postinstall": "prisma generate",
    "build": "npx prisma generate && next build && tsc workers/zk-sync-worker.ts --outDir dist/workers --esModuleInterop",
    "build:next": "next build",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "start": "concurrently --kill-others-on-fail -c \"blue,green\" \"node worker.js\" \"next start\"",
    "start:custom": "concurrently --kill-others-on-fail -c \"blue,green\" \"node worker.js\" \"sh ./entrypoint.sh\"",
    "fetch-zk": "npx tsx scripts/fetch-zk-users.ts",
    "predeploy": "npm run db:push && npm run db:seed",
    "db:push": "npx prisma db push --accept-data-loss",
    "db:seed": "npx tsx src/scripts/seedAdmins.ts",
    "db:bootstrap": "npx prisma generate && npm run db:push && npm run db:seed",
    "db:studio": "npx prisma studio",
    "db:clean-dupes": "npx tsx prisma/clean-duplicates.ts",
    "db:clean-db": "npx tsx prisma/clean-db.ts",
    "db:clean-db-dry": "DRY_RUN=true npx tsx prisma/clean-db.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^6.6.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.41",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.0",
    "cors": "^2.8.6",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "eslint-config-next": "16.2.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.4",
    "js-cookie": "^3.0.5",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "mariadb": "^3.5.2",
    "mysql2": "^3.22.3",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "node-zklib": "^1.3.0",
    "nodemailer": "^8.0.10",
    "postcss": "^8.5.4",
    "prisma": "^6.6.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-email-editor": "^1.8.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.3",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
