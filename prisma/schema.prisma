generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "mysql"
}

enum EmployeeType {
  REMOTE
  IN_HOUSE
}

// Dynamic Designation model for the RBAC Team module
// permissions is stored as JSON: { "attendance.view": true, "leaves.approve": true, ... }
model Designation {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model AttendanceLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  deviceId   String
  employeeId String
  user       User     @relation("UserAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  punchType  String
  timestamp  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, timestamp])
  @@index([timestamp(sort: Desc)])
  @@index([timestamp, punchType])
}

model Leave {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  employeeId String
  user       User     @relation("UserLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  endDate    DateTime
  reason     String
  startDate  DateTime
  status     String
  totalDays  Int
  type       String
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  titleEn   String?
  titleBn   String?
  messageEn String
  messageBn String?
  read      Boolean  @default(false)
  type      String
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model Payroll {
  id          String   @id @default(uuid())
  absentDays  Int
  baseSalary  Float
  createdAt   DateTime @default(now())
  employeeId  String
  user        User     @relation("UserPayrolls", fields: [employeeId], references: [id], onDelete: Cascade)
  grossSalary Float
  month       Int
  presentDays Int
  status      String
  totalDays   Int
  updatedAt   DateTime @updatedAt
  year        Int
}

model Performance {
  id                     String   @id @default(uuid())
  employeeId             String
  employee               User     @relation("UserPerformances", fields: [employeeId], references: [id], onDelete: Cascade)
  month                  Int
  year                   Int
  taskScore              Float
  managerRating          Float
  feedback               String
  punctualityScore       Float
  calculatedOverallScore Float
  isEOTM                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  employeeId   String   @unique
  name         String
  password     String
  isActive     Boolean  @default(true)
  baseSalary   Float    @default(0)
  department   String?
  joiningDate  DateTime @default(now())
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Dynamic RBAC — relational link to a Designation entity
  designationId       String?
  customDesignation   Designation?    @relation(fields: [designationId], references: [id], onDelete: SetNull)

  employeeType        EmployeeType    @default(IN_HOUSE)
  userType            String          @default("Employee")
  documents           Json            @default("{}")
  resetToken          String?
  resetTokenExpiry    DateTime?

  // Contact & Social Media
  phone               String?
  facebook            String?
  linkedin            String?
  github              String?
  twitter             String?

  attendanceLogs AttendanceLog[] @relation("UserAttendance")
  leaves         Leave[]         @relation("UserLeaves")
  notifications  Notification[]  @relation("UserNotifications")
  payrolls       Payroll[]       @relation("UserPayrolls")
  performances   Performance[]   @relation("UserPerformances")
}

// Single-row tenant branding config (white-label SaaS)
model TenantSettings {
  id             String   @id @default(uuid())
  companyName    String   @default("HRM Portal")
  logoUrl        String?  @db.LongText
  faviconUrl     String?  @db.LongText
  primaryColor   String   @default("#8b5cf6")
  secondaryColor String   @default("#06b6d4")
  updatedAt      DateTime @updatedAt
}

model RawDeviceLog {
  id           String   @id @default(uuid())
  deviceUserId String
  recordTime   DateTime
  punchType    String?
  ip           String?
  createdAt    DateTime @default(now())

  @@unique([deviceUserId, recordTime])
  @@index([recordTime(sort: Desc)])
}
