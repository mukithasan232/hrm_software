# ==========================================
# 🚀 HRM Portal - Environment Variables
# ==========================================

# ─── Next.js Application ───────────────────────────────────────────────
# The public-facing URL of the application (used for emails, links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The base URL for the API (defaults to /api if not set)
NEXT_PUBLIC_API_URL="/api"

# ─── Database Configuration (Prisma) ──────────────────────────────────
# MariaDB/MySQL Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/hrm_database"

# Optional: Direct connection string if using connection pooling
# DIRECT_URL=""

# ─── Authentication & Security ────────────────────────────────────────
# Secret key used for signing JWT tokens. 
# Generate a secure key using: `openssl rand -base64 32`
JWT_SECRET="generate_a_secure_random_string_here"

# ─── ZKTeco Biometric Device ──────────────────────────────────────────
# IP address of the ZKTeco time attendance machine
ZK_DEVICE_IP="192.168.10.185"

# Port of the ZKTeco machine (default is usually 4370)
ZK_DEVICE_PORT="4370"

# Communication password (COM Key) for the ZKTeco machine (default: 0)
ZK_COMM_KEY="0"

# ─── Email / SMTP Configuration (Nodemailer) ──────────────────────────
# Used for sending password resets and welcome emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM_EMAIL='"HRM Portal" <your-email@gmail.com>'

# ─── Security Settings ────────────────────────────────────────────────
# Allowed CORS origins for cross-domain API access (if applicable)
ALLOWED_ORIGIN="*"

# ─── AI Chat Assistant (Vercel AI SDK) ────────────────────────────────
# These are optional fallbacks. The primary keys are stored in the DB via
# Settings → AI Assistant. Set these as env vars for local dev convenience.
#
# Get a Google Gemini key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
#
# Get an OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
